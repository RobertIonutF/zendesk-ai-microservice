# ================================
# Server Configuration
# ================================
PORT=3000
NODE_ENV=development

# ================================
# AI Configuration
# ================================
# Set to 'true' to use mock AI responses (no API key required for testing)
# Set to 'false' to use real OpenAI API
USE_MOCK_AI=true
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=300
OPENAI_TIMEOUT_MS=15000

# ================================
# Zendesk Configuration
# ================================
# Your Zendesk subdomain (e.g., 'mycompany' for mycompany.zendesk.com)
ZENDESK_SUBDOMAIN=your_subdomain
# Your Zendesk email address
ZENDESK_EMAIL=your_email@example.com
# Your Zendesk API token (generate from Admin > Channels > API)
ZENDESK_API_TOKEN=your_api_token_here
# Webhook secret for signature verification (recommended for production)
ZENDESK_WEBHOOK_SECRET=
ZENDESK_TIMEOUT_MS=10000

# ================================
# Security Configuration
# ================================
# CORS origins (comma-separated URLs or * for all)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Request limits
MAX_REQUEST_SIZE=1mb
REQUEST_TIMEOUT_MS=30000

# IP whitelist (optional, comma-separated IPs)
# ALLOWED_IPS=192.168.1.1,10.0.0.1

# ================================
# Logging Configuration
# ================================
LOG_LEVEL=info

# ================================
# Performance Configuration
# ================================
ENABLE_COMPRESSION=true
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300
